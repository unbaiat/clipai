<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>aa15b45b-666a-4319-8d63-57444798e09f</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>unbaiat</ProviderName>
  <DefaultLocale>ro-RO</DefaultLocale>
  <DisplayName DefaultValue="ClipAI"/>
  <Description DefaultValue="Corectează gramatical și rescrie după instrucțiuni textul selectat în e-mailuri, folosind OpenAI.">
    <Override Locale="en-US" Value="Proofread and rewrite selected text in your emails with OpenAI."/>
    <Override Locale="fr-FR" Value="Corrigez et réécrivez le texte sélectionné dans vos e-mails avec OpenAI."/>
    <Override Locale="it-IT" Value="Correggi e riscrivi il testo selezionato nelle tue e-mail con OpenAI."/>
    <Override Locale="es-ES" Value="Corrige y reescribe el texto seleccionado en tus correos con OpenAI."/>
  </Description>
  <IconUrl DefaultValue="https://unbaiat.github.io/clipai/assets/iaw-icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://unbaiat.github.io/clipai/assets/iaw-icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/unbaiat/clipai"/>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.3"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://unbaiat.github.io/clipai/taskpane.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <!-- Optional, kept as in Microsoft's Outlook template. No button runs a function, so this page never loads as one. -->
          <FunctionFile resid="Taskpane.Url"/>
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="ComposeGroup">
                <Label resid="CommandsGroup.Label"/>
                <Control xsi:type="Button" id="TaskpaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://unbaiat.github.io/clipai/assets/iaw-icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://unbaiat.github.io/clipai/assets/iaw-icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://unbaiat.github.io/clipai/assets/iaw-icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://unbaiat.github.io/clipai/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="CommandsGroup.Label" DefaultValue="ClipAI"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="ClipAI"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Deschide panoul ClipAI pentru corectură și rescriere cu OpenAI.">
          <bt:Override Locale="en-US" Value="Open ClipAI to proofread and rewrite text with OpenAI."/>
          <bt:Override Locale="fr-FR" Value="Ouvrir ClipAI pour corriger et réécrire du texte avec OpenAI."/>
          <bt:Override Locale="it-IT" Value="Apri ClipAI per correggere e riscrivere il testo con OpenAI."/>
          <bt:Override Locale="es-ES" Value="Abre ClipAI para corregir y reescribir texto con OpenAI."/>
        </bt:String>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
